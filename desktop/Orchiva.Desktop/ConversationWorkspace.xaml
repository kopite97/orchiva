<UserControl x:Class="Orchiva.Desktop.ConversationWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchiva.Desktop">
 <ScrollViewer><StackPanel Spacing="14" MaxWidth="1000" HorizontalAlignment="Stretch">
  <TextBlock Text="질문 · 상담" Style="{StaticResource PageHeading}"/>
  <InfoBar x:Name="Notice" IsOpen="True" IsClosable="False" Title="대화 준비" Message="프로젝트 목록을 불러와 선택하세요. 자유 입력으로 대화를 시작할 수 있습니다."/>
  <local:WrapPanel><Button Content="프로젝트 목록" Tag="projects" Click="Action"/><ComboBox x:Name="ProjectChoice" Header="프로젝트" Width="280" DisplayMemberPath="Label" SelectionChanged="ProjectChanged"/><Button Content="대화 목록 새로 고침" Tag="list" Click="Action"/><Button Content="새 대화" Tag="new" Click="Action"/></local:WrapPanel>
  <TextBlock x:Name="PathText" Text="원본 프로젝트 경로: 선택 전" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True"/>
  <ComboBox x:Name="ConversationChoice" Header="저장된 대화" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="ConversationChanged"/>
  <local:WrapPanel><ComboBox x:Name="ModelChoice" Header="모델" Width="250" DisplayMemberPath="Label" SelectionChanged="ModelChanged"/><ComboBox x:Name="LevelChoice" Header="추론 수준" Width="160" DisplayMemberPath="Label"/><ComboBox x:Name="AccessChoice" Header="접근 권한" Width="190" SelectedIndex="0" SelectionChanged="PolicyChanged"><ComboBoxItem Content="읽기 전용" Tag="read-only"/><ComboBoxItem Content="작업 폴더 내 수정" Tag="workspace-write"/><ComboBoxItem Content="전체 접근" Tag="danger-full-access"/></ComboBox><ComboBox x:Name="ApprovalChoice" Header="승인 방식" Width="190" SelectedIndex="1" SelectionChanged="PolicyChanged"><ComboBoxItem Content="보수적 승인 · 미지원" Tag="untrusted" IsEnabled="False"/><ComboBoxItem Content="필요 시 승인" Tag="on-request"/><ComboBoxItem Content="승인 요청 없음" Tag="never"/></ComboBox></local:WrapPanel>
  <TextBlock Text="현재 Codex는 보수적 승인(untrusted)을 지원하지 않습니다." Style="{StaticResource BodyText}"/>
  <TextBlock x:Name="PolicyText" Style="{StaticResource BodyText}"/>
  <TextBlock Text="수정 권한에서는 원본 프로젝트가 직접 바뀔 수 있습니다. 제작의 선택 반영·되돌리기는 이 대화에 적용되지 않습니다. 모델·권한·승인 방식 변경은 새 대화에서 적용합니다." Style="{StaticResource BodyText}"/>
  <TextBlock x:Name="StateText" Text="새 대화 · 아직 저장하지 않았습니다." Style="{StaticResource BodyText}" IsTextSelectionEnabled="True"/>
  <ComboBox x:Name="TurnChoice" Header="대화 이력 · 턴 선택" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="TurnChanged"/>
  <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="12"><TextBlock x:Name="QuestionText" Text="질문이 여기에 표시됩니다." TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="ResponseText" Text="답변이 여기에 표시됩니다." TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Border>
  <TextBox x:Name="InputText" Header="메시지" PlaceholderText="질문하거나 필요한 작업을 요청하세요." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" MaxLength="12000"/>
  <local:WrapPanel><Button x:Name="SendButton" Content="보내기" Tag="send" Click="Action"/><Button Content="상태 새로 고침" Tag="refresh" Click="Action"/><Button x:Name="StopButton" Content="현재 작업 중단" Tag="stop" Click="Action" IsEnabled="False"/></local:WrapPanel>
  <TextBlock Text="실행 승인 요청" Style="{StaticResource SectionHeading}"/>
  <ComboBox x:Name="PermissionChoice" Header="대기 중인 요청" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="PermissionChanged"/>
  <TextBlock x:Name="PermissionText" Text="대기 중인 승인 요청이 없습니다." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  <local:WrapPanel><ComboBox x:Name="PermissionAction" Header="응답 선택" Width="280" DisplayMemberPath="Label"/><Button Content="선택한 승인 응답 보내기" Tag="permission" Click="Action"/></local:WrapPanel>
  <TextBlock x:Name="JournalText" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True"/>
 </StackPanel></ScrollViewer>
</UserControl>
