<Window x:Class="Orchiva.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchiva.Desktop" Title="Orchiva">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="200" CompactModeThresholdWidth="800" ExpandedModeThresholdWidth="1100" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigate">
   <NavigationView.PaneHeader><TextBlock Text="Orchiva" FontSize="22" FontWeight="SemiBold" Margin="16,16,0,24"/></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="ProjectsNavigation" Content="프로젝트 선택" Tag="projects" Icon="Folder"/>
    <NavigationViewItem x:Name="HomeNavigation" Content="작업 시작" Tag="home" Icon="Edit"/>
    <NavigationViewItem x:Name="HistoryNavigation" Content="PLAN 이력" Tag="workhistory" Icon="Clock"/>
    <NavigationViewItem x:Name="InstructionsNavigation" Content="프로젝트 지침" Tag="instructions" Icon="Document"/>
    <NavigationViewItem x:Name="ConversationNavigation" Content="질문 / 상담" Tag="conversation" Icon="Message"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="기존 MVP 프로젝트" Tag="project" Icon="Folder"/>
    <NavigationViewItem Content="기존 v2 이력" Tag="history" Icon="Clock"/>
    <NavigationViewItem Content="연결 상태" Tag="connection" Icon="Link"/>
   </NavigationView.FooterMenuItems>
   <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="연결 대기" Message="지정한 실행부에 연결한 뒤 작업실에서 프로젝트를 선택하세요."/>
    <local:ConversationWorkspace x:Name="ConversationPanel" Grid.Row="1" Visibility="Collapsed"/>
   <ScrollViewer Grid.Row="1" x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"><StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1280" HorizontalAlignment="Stretch">
    <local:ProductionWorkspace x:Name="WorkspacePanel"/>
    <StackPanel x:Name="ProjectPanel" Spacing="16" Visibility="Collapsed"><TextBlock Text="프로젝트" Style="{StaticResource PageHeading}"/><TextBlock Text="연결한 실행부의 실제 프로젝트 정보를 읽습니다." Style="{StaticResource BodyText}"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock Text="{Binding ProjectName}" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding ProjectPath}" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ProjectInfo}" Style="{StaticResource BodyText}"/></StackPanel></Border>
     <Button Content="프로젝트와 이력 새로 고침" Click="Refresh"/><TextBlock Text="프로젝트 추가·초기화·새 요청은 작업실에서 시작하세요." Style="{StaticResource BodyText}"/>
    </StackPanel>
    <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="14"><TextBlock Text="PLAN 이력" Style="{StaticResource PageHeading}"/><TextBlock Text="{Binding ListMessage}" Style="{StaticResource BodyText}"/><ListView x:Name="Requests" ItemsSource="{Binding Items}" SelectionChanged="SelectRequest"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button x:Name="NextPage" Content="다음 20개 보기" Click="More" IsEnabled="False"/><TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
    <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed" Spacing="20">
     <TextBlock Text="연결과 실행 준비" Style="{StaticResource PageHeading}"/><TextBlock Text="실행부 연결 상태를 확인하고 작업을 준비합니다." Style="{StaticResource BodyText}"/>
     <Border Style="{StaticResource SurfaceCard}"><StackPanel Spacing="16"><TextBlock Text="실행부" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding Connection}" TextWrapping="Wrap"/><StackPanel Spacing="8"><Button Content="격리 실행부 시작" Click="StartRuntime"/><Button Content="다시 연결" Click="Reconnect"/></StackPanel></StackPanel></Border>
     <Expander Header="연결 진단 상세" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
     <TextBlock Text="연결 실패는 실행 실패를 의미하지 않습니다. 마지막으로 조회한 내용을 보존합니다." Style="{StaticResource BodyText}"/>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="20">
     <TextBlock Text="설정" Style="{StaticResource PageHeading}"/><TextBlock Text="화면 표시와 창을 닫을 때의 동작을 설정합니다." Style="{StaticResource BodyText}"/>
     <Border Style="{StaticResource SurfaceCard}"><StackPanel Spacing="24">
      <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="테마" Style="{StaticResource SectionHeading}"/><TextBlock Text="앱 전체에 적용합니다." Style="{StaticResource BodyText}"/></StackPanel><ComboBox Grid.Column="1" x:Name="ThemeChoice" AutomationProperties.Name="테마" SelectedIndex="0" SelectionChanged="ThemeChanged" VerticalAlignment="Center"><ComboBoxItem Content="시스템 설정"/><ComboBoxItem Content="밝게"/><ComboBoxItem Content="어둡게"/></ComboBox></Grid>
      <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="창 닫기" Style="{StaticResource SectionHeading}"/><TextBlock Text="닫기 버튼의 동작입니다." Style="{StaticResource BodyText}"/></StackPanel><ComboBox Grid.Column="1" x:Name="CloseChoice" AutomationProperties.Name="닫기 버튼 동작" SelectedIndex="0" SelectionChanged="CloseChanged" VerticalAlignment="Center"><ComboBoxItem Content="앱 종료"/><ComboBoxItem Content="트레이 최소화"/></ComboBox></Grid>
     </StackPanel></Border>
     <TextBlock Text="실행 도구 준비" Style="{StaticResource SectionHeading}"/><Button Content="Git·Codex 설치와 인증 확인" Click="CheckTools"/><TextBlock x:Name="ToolStatus" Text="상태만 확인하며 설치·로그인·인증 변경은 수행하지 않습니다." Style="{StaticResource BodyText}" IsTextSelectionEnabled="True"/>
     <TextBlock Text="앱 종료는 화면과 연결 프로세스를 닫습니다. 실행 중인 제작 작업은 분리된 실행부에서 계속됩니다." Style="{StaticResource BodyText}"/>
    </StackPanel>
    <TextBlock Text="{Binding Updated}" Style="{StaticResource BodyText}"/>
   </StackPanel></ScrollViewer></Grid>
  </NavigationView>
 </Grid>
</Window>
