<Window x:Class="Orchiva.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Orchiva.Desktop" Title="Orchiva">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigate" Header="Orchiva · 프로젝트와 PLAN">
   <NavigationView.MenuItems><NavigationViewItem Content="작업실" Tag="workspace" Icon="Edit" IsSelected="True"/><NavigationViewItem Content="기존 MVP 프로젝트" Tag="project" Icon="Folder"/><NavigationViewItem Content="기존 v2 이력" Tag="history" Icon="Clock"/><NavigationViewItem Content="연결 상태" Tag="connection" Icon="Link"/></NavigationView.MenuItems>
   <ScrollViewer><StackPanel Padding="{StaticResource PagePadding}" Spacing="20">
    <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="연결 대기" Message="지정한 실행부에 연결한 뒤 작업실에서 프로젝트를 선택하세요."/>
    <local:ProductionWorkspace x:Name="WorkspacePanel"/>
    <StackPanel x:Name="ProjectPanel" Spacing="16" Visibility="Collapsed"><TextBlock Text="프로젝트" Style="{StaticResource PageHeading}"/><TextBlock Text="연결한 실행부의 실제 프로젝트 정보를 읽습니다." Style="{StaticResource BodyText}"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock Text="{Binding ProjectName}" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding ProjectPath}" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ProjectInfo}" Style="{StaticResource BodyText}"/></StackPanel></Border>
     <Button Content="프로젝트와 이력 새로 고침" Click="Refresh"/><TextBlock Text="프로젝트 추가·초기화·새 요청은 작업실에서 시작하세요." Style="{StaticResource BodyText}"/>
    </StackPanel>
    <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="14"><TextBlock Text="PLAN 이력" Style="{StaticResource PageHeading}"/><TextBlock Text="{Binding ListMessage}" Style="{StaticResource BodyText}"/><ListView x:Name="Requests" ItemsSource="{Binding Items}" SelectionChanged="SelectRequest"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button x:Name="NextPage" Content="다음 20개 보기" Click="More" IsEnabled="False"/><TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
    <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed" Spacing="14"><TextBlock Text="연결과 실행 준비" Style="{StaticResource PageHeading}"/><TextBlock Text="{Binding Connection}" Style="{StaticResource BodyText}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="격리 실행부 시작" Click="StartRuntime"/><Button Content="다시 연결" Click="Reconnect"/></StackPanel><TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="연결 실패는 실행 실패를 의미하지 않습니다. 마지막으로 조회한 내용을 보존합니다." Style="{StaticResource BodyText}"/></StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="설정" Style="{StaticResource PageHeading}"/><ComboBox x:Name="ThemeChoice" Header="테마" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="시스템 설정"/><ComboBoxItem Content="밝게"/><ComboBoxItem Content="어둡게"/></ComboBox><ComboBox x:Name="CloseChoice" Header="닫기 버튼 동작" SelectedIndex="0" SelectionChanged="CloseChanged"><ComboBoxItem Content="앱 종료"/><ComboBoxItem Content="트레이 최소화"/></ComboBox><TextBlock Text="앱 종료는 화면과 연결 프로세스를 닫습니다. 실행부의 수명은 분리되어 있으며 진행 작업 처리 정책은 제작 기능 단계에서 확정합니다." Style="{StaticResource BodyText}"/></StackPanel>
    <TextBlock Text="{Binding Updated}" Style="{StaticResource BodyText}"/>
   </StackPanel></ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
