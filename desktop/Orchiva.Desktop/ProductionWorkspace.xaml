<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:presentation="using:Orchiva.Desktop.Presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Orchiva.Desktop.ProductionWorkspace" SizeChanged="WorkspaceSizeChanged">
  <StackPanel Spacing="24" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8">
      <TextBlock x:Name="PageTitle" Text="프로젝트" Style="{StaticResource PageHeading}" />
      <TextBlock x:Name="PageDescription" Text="이어갈 프로젝트를 선택하세요." Style="{StaticResource BodyText}" />
      <InfoBar x:Name="Notice" IsOpen="True" IsClosable="False" Title="프로젝트 선택" Message="연결 후 프로젝트를 불러오세요." />
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="ProjectLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      <TextBlock x:Name="RequestStatus" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel x:Name="ProjectsPage" Spacing="24" Visibility="Collapsed">
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="＋ 프로젝트 추가" Tag="setup" Click="GoPage" />
          <Button Content="목록 새로 고침" Tag="projects" Click="Action" VerticalAlignment="Bottom" />
        </presentation:ActionPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock x:Name="ProjectListHint" Text="목록 새로 고침으로 등록된 프로젝트를 불러오세요." Style="{StaticResource BodyText}" />
          <ListView x:Name="ProjectChoice" SelectionChanged="ProjectSelected" HorizontalContentAlignment="Stretch" AutomationProperties.Name="프로젝트 목록">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="8" Padding="12">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Style="{StaticResource BodyText}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
      <TextBlock Text="프로젝트의 실제 소스와 문서를 읽습니다. 등록만으로 소스 파일을 변경하지 않습니다." Style="{StaticResource BodyText}" />
    </StackPanel>
    <StackPanel x:Name="SetupPage" Spacing="24" Visibility="Collapsed">
      <Grid Tag="split" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="1  경로 등록" Style="{StaticResource SectionHeading}" />
              <TextBox x:Name="ProjectNameInput" Header="프로젝트 이름" />
              <TextBox x:Name="SourceInput" Header="소스 폴더의 절대 경로" PlaceholderText="C:\Projects\MyProject" />
              <Button Content="프로젝트 등록" Tag="register" Click="Action" />
              <TextBlock Text="등록한 프로젝트는 프로젝트 목록에서 선택한 뒤 초기화합니다." Style="{StaticResource BodyText}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="2  변경 확인과 초기화" Style="{StaticResource SectionHeading}" />
              <Button Content="초기화 미리보기" Tag="preview" Click="Action" />
              <TextBox x:Name="InitPreview" Header="초기화 변경 내용" IsReadOnly="True" AcceptsReturn="True" MaxHeight="360" TextWrapping="Wrap" MinHeight="200" />
              <Button x:Name="InitializeButton" Content="확인한 변경으로 초기화" Tag="initialize" Click="Action" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
              <TextBlock Text="기존 파일을 보존합니다. 생성·이관할 내용을 확인한 뒤 초기화하세요." Style="{StaticResource BodyText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="프로젝트 목록으로" Tag="projects" Click="GoPage" />
          <Button Content="프로젝트 설정으로" Tag="configuration" Click="GoPage" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="RoadmapPage" Spacing="12" Visibility="Collapsed">
      <TextBox x:Name="RoadmapEditor" Header="로드맵 JSON · docs/roadmap/roadmap.json" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="260" TextChanged="RoadmapEdited" />
      <presentation:ActionPanel>
        <Button Content="로드맵 저장" Tag="roadmap-save" Click="Action" />
        <Button Content="파일 다시 읽기" Tag="roadmap-open" Click="Action" />
      </presentation:ActionPanel>
      <ComboBox x:Name="RoadmapPhase" Header="Phase" SelectionChanged="RoadmapPhaseChanged" />
      <presentation:ActionPanel>
        <ComboBox x:Name="RoadmapFirst" Header="시작 Milestone" SelectionChanged="RoadmapRangeChanged" />
        <ComboBox x:Name="RoadmapLast" Header="종료 Milestone" SelectionChanged="RoadmapRangeChanged" />
        <Button Content="구간 미리보기" Tag="roadmap-preview" Click="Action" />
      </presentation:ActionPanel>
      <StackPanel x:Name="RunControls" Spacing="8" Visibility="Collapsed">
        <ComboBox x:Name="RunModel" Header="Milestone 실행 모델" DisplayMemberPath="Label" SelectionChanged="RunModelChanged" />
        <ComboBox x:Name="RunLevel" Header="추론 수준" DisplayMemberPath="Label" />
        <Expander x:Name="GitIntegrationPanel" Header="Git 통합과 GitHub 동기화" Visibility="Collapsed" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <ComboBox x:Name="GitAcceptance" Header="새 실행의 결과 반영 방식" SelectedIndex="0">
              <ComboBoxItem Content="원본에 선택 적용" /><ComboBoxItem Content="로컬 통합 브랜치" /><ComboBoxItem Content="GitHub 병합 필수" />
            </ComboBox>
            <CheckBox x:Name="UnityGateRequired" Content="Milestone 인계 전 Unity HUD 검사와 Windows Player 빌드"/>
            <CheckBox x:Name="ParallelWorkers" Content="독립 Feature 최대 2개 병렬 실행 (로컬 통합)"/>
            <CheckBox x:Name="ContinueIndependent" Content="실패한 Feature 복구 중에도 독립 Feature 배정"/>
            <TextBox x:Name="GitTarget" Header="전용 로컬 통합 브랜치" Text="develop"/>
            <TextBox x:Name="GitPrefix" Header="Feature 브랜치 접두사" Text="feature"/>
            <TextBox x:Name="GitRepository" Header="GitHub 저장소 (선택)" PlaceholderText="owner/repo"/>
            <TextBox x:Name="GitRepoId" Header="GitHub 저장소 숫자 ID"/>
            <TextBox x:Name="GitBase" Header="원격 시험 통합 브랜치"/>
            <TextBox x:Name="GitChecks" Header="필수 검사 이름 (쉼표로 구분)"/>
            <Button Tag="git-policy" Click="Action" Content="프로젝트의 저장된 정책 읽기"/>
            <Button Tag="git-configure" Click="Action" Content="기존 완료 실행의 통합 설정 고정"/>
            <Button Tag="git-advance" Click="Action" Content="승인된 다음 Feature 통합"/>
            <Button Tag="git-read" Click="Action" Content="통합 SHA·Issue·PR 조회"/>
            <ComboBox x:Name="GitFeature" Header="게시할 Feature" SelectionChanged="GitFeatureChanged"/>
            <TextBox x:Name="GitPublicPlan" Header="GitHub에 공개할 PLAN" AcceptsReturn="True" TextWrapping="Wrap"/>
            <TextBlock x:Name="GitReport" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <Button Tag="git-publish" Click="Action" Content="공개 PLAN 확인 후 Issue·PR 게시"/>
            <Button Tag="git-observe" Click="Action" Content="원격 상태 대조"/>
            <Button Tag="git-adopt" Click="Action" Content="표시된 원격 편집 수용"/>
            <Button Tag="git-overwrite" Click="Action" Content="표시된 원격본을 로컬 PLAN으로 교체"/>
            <Button Tag="git-merge" Click="Action" Content="독립 리뷰·필수 검사 확인 후 PR 병합"/>
            <Button Tag="git-refresh-base" Click="Action" Content="승인 파일로 PR 기준 갱신"/>
            <Button Tag="git-owner-merge" Click="Action" Content="1인 개발 · 표시된 커밋의 병합 승인 (필수 검사 통과 시)"/>
          </StackPanel>
        </Expander>
        <Button Content="확인한 구간으로 실행 만들기" Tag="run-create" Click="Action" />
        <Button Content="저장된 실행 목록" Tag="run-list" Click="Action" />
        <ComboBox x:Name="RunChoice" Header="저장된 실행" />
        <Button Content="선택한 실행을 새 구간으로 재실행" Tag="run-rerun" Click="Action" />
        <Button Content="진행 상황 조회" Tag="run-read" Click="Action" />
        <TextBlock x:Name="RunReport" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        <StackPanel x:Name="PhasePanel" Visibility="Collapsed" Spacing="6">
          <TextBlock Text="Phase 플레이 검토" Style="{StaticResource SubtitleTextBlockStyle}"/>
          <TextBlock x:Name="PhaseReport" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <TextBox x:Name="PhaseNote" Header="레벨·조작감·밸런스 판단과 사유" AcceptsReturn="True"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PhaseApprove" Content="이 빌드 승인" Tag="phase-approve" Click="Action"/>
            <Button x:Name="PhaseReject" Content="반려" Tag="phase-reject" Click="Action"/>
          </StackPanel>
        </StackPanel>
        <ComboBox x:Name="RunNode" Header="Feature 요청" DisplayMemberPath="Label" />
        <Button Content="선택한 통합 커밋의 Unity PLAN 검사" Tag="unity-plan" Click="Action"/>
        <Button Content="선택한 통합 커밋의 Unity 빌드·플레이 검사" Tag="unity-integration" Click="Action"/>
        <Button Content="선택한 Feature의 PLAN·결과 열기" Tag="run-node" Click="Action" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="신규 배정 일시중지" Tag="run-pause" Click="Action" />
          <Button Content="실행 취소 (worker 종료 후)" Tag="run-cancel" Click="Action" />
          <Button Content="입력 확인 후 재개" Tag="run-resume" Click="Action" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="RoadmapSummary" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </StackPanel>
    <StackPanel x:Name="HomePage" Spacing="24" Visibility="Collapsed">
      <Button x:Name="RoadmapEntry" Content="Milestone 자동화" Tag="roadmap-open" Click="Action" Visibility="Collapsed" />
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock Text="현재 프로젝트" Style="{StaticResource SectionHeading}" />
          <TextBlock x:Name="HomeProject" Text="프로젝트를 선택하세요." TextWrapping="Wrap" />
          <Button Content="프로젝트 설정" Tag="configuration" Click="GoPage" />
        </StackPanel>
      </Border>
      <TextBlock Text="작업 분야" Style="{StaticResource SectionHeading}" />
      <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="200" ItemHeight="132" x:Name="DisciplineCards" MaximumRowsOrColumns="3">
        <Button Tag="0" Click="ChooseDiscipline" IsEnabled="True" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="기획">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="기획" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="구조 · 문서 · 콘텐츠" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Tag="1" Click="ChooseDiscipline" IsEnabled="True" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="코딩">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="코딩" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="기능 · 개선 · 오류 수정" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Tag="2" Click="ChooseDiscipline" IsEnabled="False" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="아트 · 후속 단계">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="아트" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="이미지 · 리소스 · 후속 단계" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Tag="3" Click="ChooseDiscipline" IsEnabled="False" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="사운드 · 후속 단계">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="사운드" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="효과음 · 음악 · 후속 단계" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Tag="4" Click="ChooseDiscipline" IsEnabled="False" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="특수효과 · 후속 단계">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="특수효과" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="엔진 · 연출 · 후속 단계" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
        <Button Tag="5" Click="ChooseDiscipline" IsEnabled="False" MinHeight="72" Margin="0,0,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Height="116" AutomationProperties.Name="질문 / 상담 · 후속 단계">
          <StackPanel Spacing="8">
            <FontIcon Glyph="" HorizontalAlignment="Left" FontSize="20" />
            <TextBlock Text="질문 / 상담" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="자유롭게 대화 · 후속 단계" TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </VariableSizedWrapGrid>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock Text="요청 시작" Style="{StaticResource SectionHeading}" />
          <Button Content="새 요청 →" Tag="0" Click="BeginRequest" />
          <Button Content="수정 요청 →" Tag="1" Click="BeginRequest" />
          <TextBlock Text="수정 요청은 이전 작업과 연결합니다. 같은 목표의 실패 복구는 실행 화면에서 재개하세요." Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="InstructionsPage" Spacing="24" Visibility="Collapsed">
      <Grid Tag="split-reverse" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="실제 지침 파일" Style="{StaticResource SectionHeading}" />
              <Button Content="지침·누락 다시 확인" Tag="instructions" Click="Action" />
              <ListView x:Name="InstructionChoice" SelectionChanged="InstructionSelected" MaxHeight="400" HorizontalContentAlignment="Stretch" AutomationProperties.Name="지침 파일 목록">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="8" Padding="12">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBox x:Name="InstructionPath" Header="지침 경로" PlaceholderText="docs/agents/art.md" />
              <TextBox x:Name="InstructionScope" Header="적용 범위" Text="all" />
              <TextBox x:Name="InstructionContent" Header="내용" AcceptsReturn="True" MinHeight="300" MaxHeight="500" TextWrapping="Wrap" />
              <TextBlock Text="편집 시 읽은 내용과 현재 파일을 저장 시 대조합니다. 새 지침은 루트 AGENTS.md의 지도에서도 연결하세요." Style="{StaticResource BodyText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="지침 파일 저장" Tag="save-instruction" Click="Action" Style="{StaticResource AccentButtonStyle}" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="ConfigurationPage" Spacing="24" Visibility="Collapsed">
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock Text="선택한 프로젝트 설정" Style="{StaticResource SectionHeading}" />
          <TextBox x:Name="BaseRefInput" Header="Git 기준 브랜치" Text="main" />
          <TextBox x:Name="OutputInput" Header="결과물 폴더의 절대 경로" PlaceholderText="소스와 분리된 기존 폴더" />
          <TextBlock Text="결과물은 소스와 분리된 기존 폴더에 저장합니다. 프로젝트 이름은 연결·초기화 화면의 이름 입력을 사용합니다." Style="{StaticResource BodyText}" />
          <Button Content="이름과 소스 경로 확인" Tag="setup" Click="GoPage" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="프로젝트 설정 저장" Tag="configure" Click="Action" Style="{StaticResource AccentButtonStyle}" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="RequestPage" Spacing="24" Visibility="Collapsed">
      <Grid Tag="split" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBox x:Name="TitleInput" Header="요청 제목" />
              <TextBox x:Name="GoalInput" Header="원하는 결과" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
              <TextBox x:Name="ScopeInput" Header="작업 범위" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
              <TextBox x:Name="ConstraintsInput" Header="제약·참고 사항" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="작업 대상" Style="{StaticResource SectionHeading}" />
              <ComboBox x:Name="Discipline" Header="작업 분야" SelectedIndex="1" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="기획" />
                <ComboBoxItem Content="코딩" />
                <ComboBoxItem Content="아트 · 후속 단계" IsEnabled="False" />
                <ComboBoxItem Content="사운드 · 후속 단계" IsEnabled="False" />
                <ComboBoxItem Content="특수효과 · 후속 단계" IsEnabled="False" />
                <ComboBoxItem Content="질문/상담 · 후속 단계" IsEnabled="False" />
              </ComboBox>
              <ComboBox x:Name="RequestMode" Header="요청 유형" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="RequestModeChanged">
                <ComboBoxItem Content="새 요청" />
                <ComboBoxItem Content="선택한 이전 작업의 수정 요청" />
              </ComboBox>
              <ComboBox x:Name="ParentChoice" Header="수정할 이전 작업" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="결과물과 실행 옵션" Style="{StaticResource SectionHeading}" />
              <TextBox x:Name="OutputPathInput" Header="결과물 하위 폴더 (선택)" PlaceholderText="예: features" />
              <ComboBox x:Name="ModelChoice" Header="모델" DisplayMemberPath="Label" SelectionChanged="ModelSelected" HorizontalAlignment="Stretch" />
              <ComboBox x:Name="LevelChoice" Header="수준" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
              <ComboBox x:Name="ValidationChoice" Header="자동 확인" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="파일 변경·결과 근거 확인" />
                <ComboBoxItem Content="기존 Node 테스트 자동 탐색·실행" />
              </ComboBox>
              <TextBlock Text="파일 이름은 프로젝트 명명 지침을 따릅니다." Style="{StaticResource BodyText}" />
              <Button Content="프로젝트 지침 보기" Tag="instructions" Click="GoPage" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="요청 저장" Tag="save" Click="Action" />
          <Button Content="AI로 PLAN 작성" Tag="plan" Click="Action" Style="{StaticResource AccentButtonStyle}" />
          <Button Content="PLAN 확인 화면" Tag="plan" Click="GoPage" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="PlanPage" Spacing="24" Visibility="Collapsed">
      <Grid Tag="split" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBox x:Name="PlanText" Header="PLAN 원문" IsReadOnly="True" AcceptsReturn="True" MinHeight="360" MaxHeight="900" TextWrapping="Wrap" />
              <TextBlock x:Name="PlanLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="실행 정보" Style="{StaticResource SectionHeading}" />
              <TextBlock x:Name="PlanSummary" Text="저장한 요청의 PLAN을 확인하세요." TextWrapping="Wrap" />
              <TextBlock Text="실행 후 원본 소스 반영은 별도로 검토합니다." Style="{StaticResource BodyText}" />
              <Button Content="요청 수정" Tag="request" Click="GoPage" />
              <Button Content="지침 보기" Tag="instructions" Click="GoPage" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="외부에서 수정한 PLAN 다시 읽기" Tag="sync-plan" Click="Action" />
          <CheckBox x:Name="PlanConfirmed">
            <TextBlock Text="이 PLAN과 실행 범위를 확인했습니다." TextWrapping="Wrap" />
          </CheckBox>
          <Button Content="확인한 PLAN 실행" Style="{StaticResource AccentButtonStyle}" Tag="start" Click="Action" />
          <Button Content="실행 상태·결과 새로 고침" Tag="observe" Click="Action" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="ExecutionPage" Spacing="24" Visibility="Collapsed">
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock x:Name="ExecutionStatus" Style="{StaticResource SectionHeading}" TextWrapping="Wrap" />
          <TextBlock Text="실행 상태와 관측 오류를 구분합니다. 중단 요청 후 실제 종료를 확인합니다." Style="{StaticResource BodyText}" />
          <Button Content="실행 상태·결과 새로 고침" Tag="observe" Click="Action" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <Expander Header="에이전트 권한·확인 요청" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
              <Button Content="대기 요청 읽기" Tag="attention" Click="Action" />
              <ComboBox x:Name="PermissionChoice" Header="확인할 요청" DisplayMemberPath="Label" SelectionChanged="PermissionSelected" HorizontalAlignment="Stretch" />
              <TextBox x:Name="PermissionDetails" Header="요청 세부 내용" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" />
              <ComboBox x:Name="PermissionAction" Header="처리 방법" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
              <CheckBox x:Name="PermissionConfirmed">
                <TextBlock Text="요청의 명령·경로와 처리 방법을 확인했습니다." TextWrapping="Wrap" />
              </CheckBox>
              <Button Content="선택한 응답 전송" Tag="permission" Click="Action" />
              <TextBlock Text="질문형 요청은 이 화면에서 거부한 뒤 보완 내용을 전달하세요. 임의의 질문 답변을 자동으로 만들지 않습니다." TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Grid Tag="split" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="같은 세션에서 보완" Style="{StaticResource SectionHeading}" />
              <TextBox x:Name="ResumeInput" Header="같은 실행에 전달할 보완 내용" AcceptsReturn="True" TextWrapping="Wrap" />
              <Button Content="같은 세션에서 재개" Tag="resume" Click="Action" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="실패 복구" Style="{StaticResource SectionHeading}" />
              <Button Content="불확실한 전송 대조" Tag="reconcile" Click="Action" />
              <Button Content="확인된 준비 실패 재시도" Tag="retry" Click="Action" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="현재 실행 중단 요청" Tag="stop" Click="Action" />
          <Button Content="결과 검토 →" Tag="result" Click="GoPage" />
          <Button Content="확인한 PLAN" Tag="plan" Click="GoPage" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="ResultPage" Spacing="24" Visibility="Collapsed">
      <Grid Tag="split" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <ItemsControl x:Name="ResultCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeading}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="현재 결과 검토" Style="{StaticResource SectionHeading}" />
              <TextBlock Text="왼쪽에 과거 결과가 함께 표시되더라도 판정은 현재 결과에 연결됩니다." Style="{StaticResource BodyText}" />
              <CheckBox x:Name="QualityConfirmed">
                <TextBlock Text="결과물을 검토했고 요청에 맞는 품질임을 확인했습니다." TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox x:Name="ChecksConfirmed">
                <TextBlock Text="자동 검사 결과와 검사 파일 변경 내용을 확인했습니다." TextWrapping="Wrap" />
              </CheckBox>
              <TextBox x:Name="ReviewNote" Header="검토 메모 · 수정 요청 시 사유 필수" AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Expander Header="검증 근거와 결과 이력 원문" HorizontalAlignment="Stretch">
        <TextBox x:Name="ResultText" Header="검증 근거와 결과 이력" IsReadOnly="True" AcceptsReturn="True" MinHeight="240" MaxHeight="700" TextWrapping="Wrap" />
      </Expander>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="완료 승인" Tag="approve" Click="Action" Style="{StaticResource AccentButtonStyle}" />
          <Button Content="수정 필요" Tag="reject" Click="Action" />
          <Button Content="자동 검사 다시 실행" Tag="revalidate" Click="Action" />
          <Button Content="소스 반영 검토 →" Tag="apply" Click="GoPage" />
        </presentation:ActionPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="ApplyPage" Spacing="24" Visibility="Collapsed">
      <TextBlock Text="현재 결과의 차이를 읽고 반영할 파일을 선택하세요. 충돌 검사는 기존 실행부에서 수행합니다." Style="{StaticResource BodyText}" />
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="승인한 결과물 내보내기" Tag="export" Click="Action" />
          <Button Content="소스 차이 확인" Tag="diff" Click="Action" />
        </presentation:ActionPanel>
      </Border>
      <TextBlock x:Name="ExportLocation" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      <Grid Tag="split-reverse" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBlock Text="반영할 파일" Style="{StaticResource SectionHeading}" />
              <ListView x:Name="DiffFiles" SelectionMode="Multiple" DisplayMemberPath="Label" SelectionChanged="DiffSelected" MaxHeight="300" AutomationProperties.Name="소스에 반영할 파일 선택" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="24">
          <Border Style="{StaticResource SurfaceCard}">
            <StackPanel Spacing="16">
              <TextBox x:Name="DiffText" Header="선택 파일 · 현재 소스 / 결과물" IsReadOnly="True" AcceptsReturn="True" MinHeight="300" MaxHeight="500" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="선택한 파일을 소스에 반영" Tag="apply" Click="Action" Style="{StaticResource AccentButtonStyle}" />
          <Button Content="결과로 돌아가기" Tag="result" Click="GoPage" />
        </presentation:ActionPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock Text="반영 이력과 복원" Style="{StaticResource SectionHeading}" />
          <Button Content="반영·되돌리기 이력 읽기" Tag="transfers" Click="Action" />
          <ComboBox x:Name="TransferChoice" Header="보존된 반영 작업" DisplayMemberPath="Label" SelectionChanged="TransferSelected" HorizontalAlignment="Stretch" />
          <Button Content="선택한 미완료 반영 이어서 처리" Tag="continue-apply" Click="Action" />
          <TextBox x:Name="TransferKey" Header="반영 작업 식별자 · 재연결 후 되돌리기에도 사용" />
          <Button Content="해당 반영 작업 되돌리기" Tag="undo" Click="Action" />
          <TextBlock Text="원본 백업과 과거 이력은 보존합니다. Git 커밋·push는 수행하지 않습니다." Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel x:Name="HistoryPage" Spacing="24" Visibility="Collapsed">
      <Border Style="{StaticResource ActionBar}">
        <presentation:ActionPanel>
          <Button Content="작업 이력 불러오기" Tag="requests" Click="Action" />
          <Button Content="새 요청 작성" Tag="new" Click="Action" />
        </presentation:ActionPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock x:Name="RequestListHint" Text="프로젝트를 선택하고 작업 이력을 불러오세요." Style="{StaticResource BodyText}" />
          <ListView x:Name="RequestChoice" SelectionChanged="RequestSelected" MaxHeight="320" HorizontalContentAlignment="Stretch" AutomationProperties.Name="프로젝트 PLAN 이력">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="8" Padding="12">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SurfaceCard}">
        <StackPanel Spacing="16">
          <TextBlock Text="선택한 PLAN의 이력" Style="{StaticResource SectionHeading}" />
          <TextBlock x:Name="HistorySummary" Text="이력에서 작업을 선택하세요." TextWrapping="Wrap" />
          <Button Content="PLAN 열기" Tag="plan" Click="GoPage" />
          <Button Content="실행 / 복구" Tag="execution" Click="GoPage" />
          <Button Content="결과 상세" Tag="result" Click="GoPage" />
        </StackPanel>
      </Border>
      <Expander Header="기존 v2 이력 가져오기" HorizontalAlignment="Stretch">
        <StackPanel Spacing="16">
          <TextBox x:Name="LegacyToken" Header="연결된 실행부의 기존 요청 식별자" />
          <Button Content="원본을 보존하고 보관용 이력 가져오기" Tag="import-legacy" Click="Action" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
