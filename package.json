{
  "name": "orchiva-plugin",
  "private": true,
  "version": "0.0.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:lifecycle": "node scripts/lifecycle-smoke.mjs verify",
    "lifecycle": "node scripts/lifecycle-smoke.mjs",
    "m0": "node --import tsx scripts/m0-foundation.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "8.22.2",
    "zod": "^4.4.3"
  },
  "type": "module"
}
